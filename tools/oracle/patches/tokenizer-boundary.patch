 #include "synthdata.h"            // for SelectPhonemeTable, LookupPhonemeTable
 #include "synthesize.h"           // for PHONEME_LIST2, N_PHONEME_LIST, PHON...
@@ -1089,6 +1090,7 @@ void TranslateClauseWithTerminator(Translator *tr, int *tone_out, char **voice_c
 		charix[ix] = 0;
 	MAKE_MEM_UNDEFINED(&source, sizeof(source));
 	terminator = ReadClause(tr, source, charix, &charix_top, N_TR_SOURCE, &tone, voice_change_name);
+	if (jspeak_read_hook) jspeak_read_hook(tr, source, charix, charix_top, terminator, tone);
 
 	if (terminator_out != NULL) {
 		*terminator_out = terminator;
@@ -1662,6 +1664,18 @@ void TranslateClauseWithTerminator(Translator *tr, int *tone_out, char **voice_c
 	}
 	words[0].flags |= FLAG_FIRST_WORD;
 
+	if (jspeak_words_hook) {
+		JSPEAK_TOKENIZER_STATE state = {
+			source_index, source_index_word, word_flags, next_word_flags, finished,
+			count_words, count_sentences, max_clause_pause, clause_pause,
+			new_sentence, new_sentence2, terminator, {0}
+		};
+		jspeak_capture_embedded_state(&state.embedded, embedded_count);
+		if (jspeak_words_hook(tr, source, charix, charix_top, sbuf,
+		                     (size_t)(tr->clause_end - sbuf + 1), words, word_count, &state))
+			return;
+	}
+
 	// Each TranslateWord2 may require up to 7 phonemes
 	// and after this loop we require 2 phonemes
 	for (ix = 0; ix < word_count && (n_ph_list2 < N_PHONEME_LIST-7-2); ix++) {
@@ -1988,3 +2002,26 @@ void InitText(int control)
 	if ((control & espeakKEEP_NAMEDATA) == 0)
 		InitNamedata();
 }
+
+/* Direct wrappers keep original static algorithms and their sequence state. */
+int jspeak_translate_char(Translator *tr, char *ptr, int prev, unsigned int cp, unsigned int next, int *insert, int *flags)
+{
+    return TranslateChar(tr, ptr, prev, cp, next, insert, flags);
+}
+int jspeak_substitute_char(Translator *tr, unsigned int cp, unsigned int next, const char *ptr, int *insert, int *flags)
+{
+    return SubstituteChar(tr, cp, next, ptr, insert, flags);
+}
+int jspeak_should_split_ideographs(Translator *tr, int cp, int previous)
+{
+    return ShouldSplitIdeographs(tr, cp, previous);
+}
+void jspeak_capture_embedded_state(JSPEAK_EMBEDDED_STATE *out, int pending_count)
+{
+    *out = (JSPEAK_EMBEDDED_STATE){embedded_ix, embedded_read, option_sayas2,
+        count_sayas_digits, word_emphasis, option_sayas, option_emphasis, pending_count};
+}
+int jspeak_embedded_capacity(void)
+{
+    return N_EMBEDDED_LIST;
+}
