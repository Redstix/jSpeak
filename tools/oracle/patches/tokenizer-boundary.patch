@@ -0,0 +1,26 @@
+/* Development-only tokenizer boundary hooks and direct primitive wrappers. */
+#ifndef JSPEAK_TOKENIZER_H
+#define JSPEAK_TOKENIZER_H
+#include <stddef.h>
+#include "translate.h"
+typedef struct {
+    int embedded_ix, embedded_read, option_sayas2, count_sayas_digits;
+    int word_emphasis, option_sayas, option_emphasis, pending_count;
+} JSPEAK_EMBEDDED_STATE;
+typedef struct {
+    unsigned int source_index;
+    int source_index_word, word_flags, next_word_flags, finished;
+    int count_words, count_sentences, max_clause_pause, clause_pause;
+    int new_sentence, start_sentence, terminator;
+    JSPEAK_EMBEDDED_STATE embedded;
+} JSPEAK_TOKENIZER_STATE;
+typedef void (*JSPEAK_READ_HOOK)(Translator *, const char *, const short *, int, int, int);
+typedef int (*JSPEAK_WORDS_HOOK)(Translator *, const char *, const short *, int, const char *, size_t, const WORD_TAB *, int, const JSPEAK_TOKENIZER_STATE *);
+extern JSPEAK_READ_HOOK jspeak_read_hook;
+extern JSPEAK_WORDS_HOOK jspeak_words_hook;
+int jspeak_translate_char(Translator *, char *, int, unsigned int, unsigned int, int *, int *);
+int jspeak_substitute_char(Translator *, unsigned int, unsigned int, const char *, int *, int *);
+int jspeak_should_split_ideographs(Translator *, int, int);
+void jspeak_capture_embedded_state(JSPEAK_EMBEDDED_STATE *, int);
+int jspeak_embedded_capacity(void);
+#endif
diff --git a/src/libespeak-ng/translate.c b/src/libespeak-ng/translate.c
