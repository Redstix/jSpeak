new file mode 100644
index 00000000..945755d9
--- /dev/null
+++ b/src/libespeak-ng/jstrace.c
@@ -0,0 +1,36 @@
+/* jSpeak development-only observation helpers; no synthesis state mutations. */
+#include "jstrace.h"
+#include <stdlib.h>
+#include <string.h>
+static FILE *trace_file;
+static unsigned long trace_seq;
+static int initialized;
+FILE *js_trace_event(const char *kind)
+{
+    if (!initialized) {
+        const char *name = getenv("JSPEAK_TRACE_FILE");
+        initialized = 1;
+        if (name && *name) {
+            trace_file = fopen(name, "wb");
+            if (!trace_file) { perror("JSPEAK_TRACE_FILE"); exit(74); }
+        }
+    }
+    if (trace_file) fprintf(trace_file, "{\"seq\":%lu,\"kind\":\"%s\"", trace_seq++, kind);
+    return trace_file;
+}
+void js_trace_bytes(FILE *out, const char *bytes, size_t length)
+{
+    size_t i;
+    fputc('"', out);
+    for (i = 0; i < length; i++) fprintf(out, "%02x", (unsigned char)bytes[i]);
+    fputc('"', out);
+}
+void js_trace_hex(FILE *out, const char *bytes)
+{
+    js_trace_bytes(out, bytes, strlen(bytes));
+}
+void js_trace_end(FILE *out)
+{
+    fputs("}\n", out);
+    if (fflush(out) != 0 || ferror(out)) { perror("JSPEAK_TRACE_FILE write"); exit(74); }
+}
