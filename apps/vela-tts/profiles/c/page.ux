<template>
  <div class="page">
    <text class="title">jSpeak TTS 0.5.2-C</text>
    <div class="body">
      <text class="note">C档：A输出4:1平均降采样，5512Hz/16bit</text>
      <input class="button" type="button" value="播放" onclick="play" />
      <input class="button" type="button" value="停止" onclick="stop" />
      <text class="note">结果在下方；请记录是否听到英文。</text>
      <text class="value">{{status}}</text>
    </div>
  </div>
</template>
<script>
import audio from '@system.audio'
import { BUILD_STAMP } from '../../build-stamp'

export default {
  private: {
  status: 'READY 0.5.2-C ' + BUILD_STAMP
  },
  onInit() { this.status = 'READY 0.5.2-C ' + BUILD_STAMP },
  onHide() { this.stop() },
  onDestroy() { this.stop() },
  play() {
    this.stop()
    this.status = 'PLAYING /common/jspeak/audio.wav'
    audio.onplay = () => { this.status = 'EVENT onplay' }
    audio.onended = () => { this.status = 'DONE；听感待用户确认' }
    audio.onerror = data => { this.status = 'FAIL audio ' + String(data) }
    audio.src = '/common/jspeak/audio.wav'
    audio.play()
  },
  stop() {
    audio.onplay = null
    audio.onended = null
    audio.onerror = null
    try { audio.stop() } catch (error) {}
    this.status = 'STOPPED'
  }
}
</script>
<style>
.page { flex-direction: column; background-color: #101010; padding: 28px 24px; }
.title { color: #ffffff; font-size: 25px; text-align: center; margin-bottom: 12px; }
.body { flex-direction: column; }
.note { color: #cccccc; font-size: 19px; margin-bottom: 12px; }
.button { height: 52px; margin-bottom: 10px; background-color: #303030; color: #ffffff; font-size: 21px; }
.value { color: #ffffff; font-size: 20px; }
</style>
