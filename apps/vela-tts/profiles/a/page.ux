<template>
  <div class="page">
    <text class="title">{{title}}</text>
    <scroll class="content" scroll-y="true">
      <div class="body">
        <text class="note">{{fixedNote}}</text>
        <input class="button" type="button" value="合成 / 播放" onclick="synthesize" />
        <input class="button" type="button" value="连续 10 次（不播放）" onclick="test10" />
        <input class="button" type="button" value="连续 20 次（不播放）" onclick="test20" />
        <input class="button" type="button" value="长文本（约 2K 字符，不播放）" onclick="longText" />
        <input class="button" type="button" value="停止 / 清理" onclick="stopAll" />
        <text class="note">结果在下方；RTF=合成耗时/音频时长。设备 heap/CPU 不可测。</text>
        <div class="result" for="item in results">
          <text class="label">{{item.label}}</text>
          <text class="value">{{item.value}}</text>
        </div>
      </div>
    </scroll>
  </div>
</template>
<script>
import audio from '@system.audio'
import file from '@system.file'
import { DATA_ASSETS } from '../../data-assets'
import { createTtsSession } from '../../tts-service'

export default {
  private: {
    title: 'jSpeak TTS ' + DATA_ASSETS.versionName + ' A',
    fixedNote: '固定' + (DATA_ASSETS.language === 'cmn' ? '中文' : '英文') + '：' + DATA_ASSETS.testText,
    results: [
      { label: '版本', value: 'READY ' + DATA_ASSETS.versionName + ' A ' + DATA_ASSETS.buildStamp },
      { label: '数据', value: DATA_ASSETS.files.length + ' 文件 / ' + DATA_ASSETS.totalDataBytes + 'B；语言=' + DATA_ASSETS.language },
      { label: '流程', value: 'WAITING' }
    ]
  },
  onInit() {
    this.runId = 0
    this.session = null
    this.destroyed = false
  },
  onHide() { this.stopAll() },
  onDestroy() { this.stopAll(); this.destroyed = true },
  setResult(label, value) {
    if (this.destroyed) return
    var rows = this.results.slice(); var found = false
    for (var i = 0; i < rows.length; i++) if (rows[i].label === label) { rows[i] = { label: label, value: String(value) }; found = true; break }
    if (!found) rows.push({ label: label, value: String(value) })
    this.results = rows
  },
  stopAll() {
    this.runId++
    try { audio.onplay = null; audio.onended = null; audio.onerror = null; audio.stop() } catch (error) {}
    if (this.session) this.session.cancel()
    this.session = null
    this.setResult('流程', 'STOPPED')
  },
  run(options) {
    this.stopAll()
    var token = ++this.runId
    this.session = createTtsSession(file, audio, DATA_ASSETS, {
      row: (name, value) => { if (token === this.runId) this.setResult(name, value) },
      listening: () => { if (token === this.runId) this.setResult('听感', DATA_ASSETS.listeningNote) },
      done: (message) => { if (token === this.runId) this.setResult('流程', message) },
      fail: (message) => { if (token === this.runId) this.setResult('流程', 'FAIL ' + message) },
      shouldContinue: () => token === this.runId && !this.destroyed
    })
    this.session.start(options)
  },
  synthesize() {
    this.run({ text: DATA_ASSETS.testText, repeat: 1, play: true })
  },
  test10() {
    this.run({ text: DATA_ASSETS.testText, repeat: 10, play: false })
  },
  test20() {
    this.run({ text: DATA_ASSETS.testText, repeat: 20, play: false })
  },
  longText() {
    var text = DATA_ASSETS.testText
    while (text.length < 2048) text += DATA_ASSETS.testText
    this.run({ text: text, repeat: 1, play: false })
  }
}
</script>
<style>
.page { flex-direction: column; background-color: #101010; padding: 28px 24px; }
.title { color: #ffffff; font-size: 25px; text-align: center; margin-bottom: 12px; }
.content { flex-grow: 1; flex-direction: column; }
.body { flex-direction: column; }
.note { color: #cccccc; font-size: 19px; margin-bottom: 12px; }
.button { height: 52px; margin-bottom: 10px; background-color: #303030; color: #ffffff; font-size: 21px; }
.result { flex-direction: column; margin-bottom: 16px; }
.label { color: #bbbbbb; font-size: 19px; }
.value { color: #ffffff; font-size: 20px; }
</style>
