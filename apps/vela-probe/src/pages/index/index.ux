<template>
  <div class="page">
    <text class="title">jSpeak 探针 0.3.1</text>
    <scroll class="content" scroll-y="true">
      <div class="body">
        <text class="note">手动测试 / 非 TTS。请截图结果。</text>
        <input class="button" type="button" value="1 能力检查" onclick="checkCaps" />
        <input class="button" type="button" value="2 设备信息" onclick="checkDevice" />
        <input class="button" type="button" value="3 分片计算 (可重复3次)" onclick="checkCompute" />
        <input class="button" type="button" value="4 装载判别" onclick="checkLoad" />
        <input class="button" type="button" value="停止 / 取消" onclick="stopAll" />
        <text class="note">结果在下方；BUSY 表示上次文件I/O未返回。</text>
        <div class="result" for="item in results">
          <text class="label">{{item.label}}</text>
          <text class="value">{{item.value}}</text>
        </div>
      </div>
    </scroll>
  </div>
</template>
<script>
import audio from '@system.audio'
import file from '@system.file'
import device from '@system.device'
import { capabilities, computeSlice, timingSummary, hashBytes, PROBE_BIN_HASH, BIG_TXT_HASH, SLICE_HASH } from '../../probe'
import { copyFile } from '../../scratch-file'
import { BUILD_STAMP } from '../../build-stamp'

export default {
  private: {
    results: [
      { label: 'UI / 版本', value: 'READY 0.3.1 ' + BUILD_STAMP + ' / API1200 target' },
      { label: 'PCM streaming', value: 'UNVERIFIED 本版无音频播放' }
    ]
  },
  onInit() {
    this.generation = 0
    this.timer = null
    this.watchdog = null
    this.activeLabel = null
    this.scratch = null
    this.fileSeq = 0
    this.computeRun = 0
    this.destroyed = false
  },
  onHide() { this.stopAll() },
  onDestroy() { this.stopAll(); this.destroyed = true },
  setResult(label, value) {
    if (this.destroyed) return
    var rows = this.results.slice()
    var found = false
    for (var i = 0; i < rows.length; i++) {
      if (rows[i].label === label) { rows[i] = { label: label, value: String(value) }; found = true; break }
    }
    if (!found) rows.push({ label: label, value: String(value) })
    this.results = rows
  },
  stopAudio() {
    try { audio.onplay = null; audio.onended = null; audio.onerror = null; audio.stop() }
    catch (error) { this.setResult('停止音频', 'FAIL ' + String(error)) }
  },
  stopAll() {
    this.generation++
    if (this.timer !== null) clearTimeout(this.timer)
    if (this.watchdog !== null) clearTimeout(this.watchdog)
    this.timer = null
    this.watchdog = null
    this.stopAudio()
    if (this.scratch) this.scratch.cancel()
    if (this.activeLabel) this.setResult(this.activeLabel, 'CANCELLED')
    this.activeLabel = null
    this.setResult('会话', 'STOPPED；迟到回调已忽略')
  },
  begin(label, watchdogMs) {
    this.stopAll()
    if (this.scratch && this.scratch.isPending()) {
      this.setResult(label, 'BUSY 上次文件I/O尚未返回，请稍后再试')
      return null
    }
    this.activeLabel = label
    this.setResult('会话', 'RUNNING ' + label)
    this.setResult(label, 'RUNNING')
    var token = this.generation
    this.watchdog = setTimeout(() => {
      if (token !== this.generation) return
      this.stopAll()
      this.setResult(label, 'FAIL timeout (' + (watchdogMs || 10000) / 1000 + 's)')
    }, watchdogMs || 10000)
    return token
  },
  done(label, value, token) {
    if (token !== this.generation) return
    if (this.watchdog !== null) clearTimeout(this.watchdog)
    if (this.timer !== null) clearTimeout(this.timer)
    this.watchdog = null
    this.timer = null
    this.activeLabel = null
    this.generation++
    this.stopAudio()
    if (this.scratch) this.scratch.cancel()
    this.setResult(label, value)
    this.setResult('会话', 'DONE')
  },
  checkCaps() {
    this.stopAll()
    var rows = capabilities()
    for (var i = 0; i < rows.length; i++) this.setResult(rows[i].label, rows[i].value)
  },
  checkDevice() {
    var token = this.begin('设备')
    if (token === null) return
    try {
      device.getInfo({
        success: (data) => this.done('设备', String(data.model) + ' / ' + String(data.osVersionName) + ' / API ' + String(data.platformVersionCode) + ' (仅API返回值)', token),
        fail: (data, code) => this.done('设备', 'FAIL ' + String(code) + ' ' + String(data), token)
      })
    } catch (error) { this.done('设备', 'FAIL ' + String(error), token) }
  },
  checkCompute() {
    var token = this.begin('计算')
    if (token === null) return
    this.computeRun++
    var run = (this.computeRun - 1) % 3 + 1
    var state = 1
    var slices = 0
    var started = Date.now()
    var last = started
    var durations = []
    var gaps = []
    var step = () => {
      if (token !== this.generation) return
      try {
        var now = Date.now()
        gaps.push(now - last)
        state = computeSlice(state, 2048)
        var end = Date.now()
        durations.push(end - now)
        last = end
        slices++
        if (slices === 32) {
          var summary = timingSummary(durations, gaps)
          this.setResult('计算 #' + run, (state === 437906867 ? 'PASS hash=' : 'FAIL hash=') + state + '; total=' + (end - started) + 'ms')
          this.setResult('计算 #' + run + ' 分片', 'sum=' + summary.computeMs + 'ms; max=' + summary.maxSliceMs + 'ms; firstWait=' + summary.firstWaitMs + 'ms')
          this.setResult('计算 #' + run + ' 后续等待', 'p50=' + summary.gapMedianMs + 'ms; p95=' + summary.gapP95Ms + 'ms; max=' + summary.gapMaxMs + 'ms (非RTF)')
          this.done('计算', 'DONE 65536 ops; 结果槽位 #' + run, token)
          return
        }
        this.timer = setTimeout(step, 10)
      } catch (error) { this.done('计算', 'FAIL ' + String(error), token) }
    }
    this.timer = setTimeout(step, 10)
  },
  checkLoad() {
    var token = this.begin('装载判别', 35000)
    if (token === null) return
    var labels = [
      'C1 bin.txt直读',
      'C2 big.txt直读',
      'C3 包内部分读',
      'C4 copy .txt源',
      'C5 copy .bin源',
      'C6 access .txt'
    ]
    for (var n = 0; n < labels.length; n++) this.setResult(labels[n], 'WAITING')
    var index = 0
    var next = () => {
      if (token !== this.generation) return
      if (index === labels.length) { this.done('装载判别', 'DONE 请看各项结果', token); return }
      var label = labels[index++]
      var started = Date.now()
      var settled = false
      var stepTimeout = label === 'C2 big.txt直读' ? 5000 : 3000
      this.setResult(label, 'RUNNING')
      var finish = (value) => {
        if (settled || token !== this.generation) return
        settled = true
        clearTimeout(this.timer)
        this.timer = null
        this.setResult(label, value + ' / ' + (Date.now() - started) + 'ms')
        next()
      }
      var guard = (run) => { try { run() } catch (error) { finish('FAIL ' + String(error)) } }
      this.timer = setTimeout(() => finish('FAIL timeout ' + stepTimeout / 1000 + 's'), stepTimeout)
      if (label === 'C1 bin.txt直读') {
        guard(() => file.readArrayBuffer({
          uri: '/common/bin.txt',
          success: (data) => {
            if (settled || token !== this.generation) return
            try {
              var arr = data && data.buffer
              var hash = arr ? hashBytes(arr, 0, arr.length, 1) : 'none'
              var ok = !!arr && arr.length === 65536 && hash === PROBE_BIN_HASH
              finish(ok ? 'PASS len=65536 hash=' + PROBE_BIN_HASH : 'FAIL verify len=' + (arr ? arr.length : 'none') + ' hash=' + hash)
            } catch (error) { finish('FAIL ' + String(error)) }
          },
          fail: (data, code) => finish('FAIL ' + String(code) + ' ' + String(data))
        }))
      } else if (label === 'C2 big.txt直读') {
        guard(() => file.readArrayBuffer({
          uri: '/common/big.txt',
          success: (data) => {
            if (settled || token !== this.generation) return
            try {
              var arr = data && data.buffer
              var hash = arr ? hashBytes(arr, 0, arr.length, 1) : 'none'
              var ok = !!arr && arr.length === 262144 && hash === BIG_TXT_HASH
              finish(ok ? 'PASS len=262144 hash=' + BIG_TXT_HASH : 'FAIL verify len=' + (arr ? arr.length : 'none') + ' hash=' + hash)
            } catch (error) { finish('FAIL ' + String(error)) }
          },
          fail: (data, code) => finish('FAIL ' + String(code) + ' ' + String(data))
        }))
      } else if (label === 'C3 包内部分读') {
        guard(() => file.readArrayBuffer({
          uri: '/common/bin.txt',
          position: 1024,
          length: 2048,
          success: (data) => {
            if (settled || token !== this.generation) return
            try {
              var arr = data && data.buffer
              var hash = arr ? hashBytes(arr, 0, arr.length, 1) : 'none'
              var ok = !!arr && arr.length === 2048 && hash === SLICE_HASH
              finish(ok ? 'PASS hash=' + SLICE_HASH : 'FAIL verify len=' + (arr ? arr.length : 'none') + ' hash=' + hash)
            } catch (error) { finish('FAIL ' + String(error)) }
          },
          fail: (data, code) => finish('FAIL ' + String(code) + ' ' + String(data))
        }))
      } else if (label === 'C4 copy .txt源') {
        guard(() => this.runCopyProbe(token, finish, '/common/bin.txt', 1, 'c1', 'C4', PROBE_BIN_HASH))
      } else if (label === 'C5 copy .bin源') {
        guard(() => this.runCopyProbe(token, finish, '/common/probe.bin', 2, 'c2', 'C5', PROBE_BIN_HASH))
      } else {
        guard(() => file.access({
          uri: '/common/bin.txt',
          success: (data) => {
            if (settled || token !== this.generation) return
            finish('PASS exists=' + String(data && data.exists))
          },
          fail: (data, code) => finish('FAIL ' + String(code) + ' ' + String(data))
        }))
      }
    }
    next()
  },
  runCopyProbe(token, finish, srcUri, seq, suffix, label, expected) {
    var dst = 'internal://files/jspeak-probe-031-' + Date.now() + '-' + seq + '-' + suffix + '.bin'
    this.setResult(label + ' copy', 'WAITING')
    this.setResult(label + ' 读回', 'WAITING')
    this.setResult(label + ' 清理', 'WAITING')
    var job = copyFile(file, srcUri, dst, {
      ready: (path) => {
        if (token !== this.generation) return
        this.setResult(label + ' copy', 'PASS ' + path)
        file.readArrayBuffer({
          uri: path,
          success: (data) => {
            if (token !== this.generation) return
            try {
              var arr = data && data.buffer
              var ok = !!arr && arr.length === 65536 && hashBytes(arr, 0, arr.length, 1) === expected
              var value = ok ? 'PASS hash=' + expected : 'FAIL hash 不符 len=' + (arr ? arr.length : 'none')
              this.setResult(label + ' 读回', value)
              if (job) job.cancel()
              finish(value)
            } catch (error) { finish('FAIL ' + String(error)) }
          },
          fail: (data, code) => {
            this.setResult(label + ' 读回', 'FAIL ' + String(code) + ' ' + String(data))
            if (job) job.cancel()
            finish('FAIL 读回 ' + String(code) + ' ' + String(data))
          }
        })
      },
      error: (stage, message) => finish('FAIL ' + stage + ' ' + message),
      cleanup: (message) => this.setResult(label + ' 清理', message)
    })
    this.scratch = job
    job.start()
  }
}
</script>
<style>
.page { flex-direction: column; background-color: #101010; padding: 28px 24px; }
.title { color: #ffffff; font-size: 25px; text-align: center; margin-bottom: 12px; }
.content { flex-grow: 1; flex-direction: column; }
.body { flex-direction: column; }
.note { color: #cccccc; font-size: 19px; margin-bottom: 12px; }
.button { height: 52px; margin-bottom: 10px; background-color: #303030; color: #ffffff; font-size: 21px; }
.result { flex-direction: column; margin-bottom: 18px; }
.label { color: #bbbbbb; font-size: 19px; }
.value { color: #ffffff; font-size: 20px; }
</style>
