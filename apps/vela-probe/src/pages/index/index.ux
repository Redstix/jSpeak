<template>
  <div class="page">
    <text class="title">jSpeak 探针 0.4.1</text>
    <scroll class="content" scroll-y="true">
      <div class="body">
        <text class="note">手动 D1/A1 / 非 JS TTS。请截图版本和结果。</text>
        <input class="button" type="button" value="1 能力检查" onclick="checkCaps" />
        <input class="button" type="button" value="2 设备信息" onclick="checkDevice" />
        <input class="button" type="button" value="3 分片计算 (可重复3次)" onclick="checkCompute" />
        <input class="button" type="button" value="4 D1 两大文件全读" onclick="checkLoad" />
        <input class="button" type="button" value="5 D1 分页 / 边界 / EOF" onclick="checkScan" />
        <input class="button" type="button" value="6 D1 候选集全读驻留" onclick="checkResident" />
        <input class="button" type="button" value="7 D1 分块组装驻留" onclick="checkAssemble" />
        <input class="button" type="button" value="8 A1 包内 22050Hz 语音" onclick="playPackaged" />
        <input class="button" type="button" value="9 A1 append / 头回填" onclick="checkAppend" />
        <input class="button" type="button" value="10 A1 position / 头回填" onclick="checkPosition" />
        <input class="button" type="button" value="11 A1 有界短句整写" onclick="checkBuffered" />
        <input class="button" type="button" value="停止 / 取消" onclick="stopAll" />
        <text class="note">结果在下方；BUSY 表示上次文件I/O未返回。</text>
        <div class="result" for="item in results">
          <text class="label">{{item.label}}</text>
          <text class="value">{{item.value}}</text>
        </div>
      </div>
    </scroll>
  </div>
</template>
<script>
import audio from '@system.audio'
import file from '@system.file'
import device from '@system.device'
import { capabilities, computeSlice, timingSummary } from '../../probe'
import { createDataProbe } from '../../data-loader'
import { createWavProbe } from '../../wav-file'
import { DATA_ASSETS } from '../../data-assets'
import { BUILD_STAMP } from '../../build-stamp'

export default {
  private: {
    results: [
      { label: 'UI / 版本', value: 'READY 0.4.1 ' + BUILD_STAMP + ' / API1200 target' },
      { label: '范围', value: '真实数据候选集 / Oracle WAV；非 JS 合成 / 非实时性能' },
      { label: '数据闭包', value: DATA_ASSETS.closureComplete ? '见 manifest' : 'UNVERIFIED 候选依赖，尚未证明完整' }
    ]
  },
  onInit() {
    this.generation = 0
    this.timer = null
    this.watchdog = null
    this.activeLabel = null
    this.job = null
    this.fileSeq = 0
    this.computeRun = 0
    this.dataRun = 0
    this.destroyed = false
  },
  onHide() { this.stopAll() },
  onDestroy() { this.stopAll(); this.destroyed = true },
  setResult(label, value) {
    if (this.destroyed) return
    var rows = this.results.slice()
    var found = false
    for (var i = 0; i < rows.length; i++) {
      if (rows[i].label === label) { rows[i] = { label: label, value: String(value) }; found = true; break }
    }
    if (!found) rows.push({ label: label, value: String(value) })
    this.results = rows
  },
  stopAudio() {
    try { audio.onplay = null; audio.onended = null; audio.onerror = null; audio.stop() }
    catch (error) { this.setResult('停止音频', 'FAIL ' + String(error)) }
  },
  stopAll() {
    this.generation++
    if (this.timer !== null) clearTimeout(this.timer)
    if (this.watchdog !== null) clearTimeout(this.watchdog)
    this.timer = null
    this.watchdog = null
    this.stopAudio()
    if (this.job) this.job.cancel()
    if (this.activeLabel) this.setResult(this.activeLabel, 'CANCELLED')
    this.activeLabel = null
    this.setResult('会话', 'STOPPED；迟到回调已忽略')
  },
  begin(label, watchdogMs) {
    this.stopAll()
    if (this.job && this.job.isPending()) {
      this.setResult(label, 'BUSY 上次文件I/O尚未返回，请稍后再试')
      return null
    }
    this.activeLabel = label
    this.setResult('会话', 'RUNNING ' + label)
    this.setResult(label, 'RUNNING')
    var token = this.generation
    this.watchdog = setTimeout(() => {
      if (token !== this.generation) return
      this.stopAll()
      this.setResult(label, 'FAIL timeout (' + (watchdogMs || 10000) / 1000 + 's)')
    }, watchdogMs || 10000)
    return token
  },
  done(label, value, token) {
    if (token !== this.generation) return
    if (this.watchdog !== null) clearTimeout(this.watchdog)
    if (this.timer !== null) clearTimeout(this.timer)
    this.watchdog = null
    this.timer = null
    this.activeLabel = null
    this.generation++
    this.stopAudio()
    if (this.job) this.job.cancel()
    this.setResult(label, value)
    this.setResult('会话', 'DONE')
  },
  checkCaps() {
    this.stopAll()
    var rows = capabilities()
    for (var i = 0; i < rows.length; i++) this.setResult(rows[i].label, rows[i].value)
  },
  checkDevice() {
    var token = this.begin('设备')
    if (token === null) return
    try {
      device.getInfo({
        success: (data) => this.done('设备', String(data.model) + ' / ' + String(data.osVersionName) + ' / API ' + String(data.platformVersionCode) + ' (仅API返回值)', token),
        fail: (data, code) => this.done('设备', 'FAIL ' + String(code) + ' ' + String(data), token)
      })
    } catch (error) { this.done('设备', 'FAIL ' + String(error), token) }
  },
  checkCompute() {
    var token = this.begin('计算')
    if (token === null) return
    this.computeRun++
    var run = (this.computeRun - 1) % 3 + 1
    var state = 1
    var slices = 0
    var started = Date.now()
    var last = started
    var durations = []
    var gaps = []
    var step = () => {
      if (token !== this.generation) return
      try {
        var now = Date.now()
        gaps.push(now - last)
        state = computeSlice(state, 2048)
        var end = Date.now()
        durations.push(end - now)
        last = end
        slices++
        if (slices === 32) {
          var summary = timingSummary(durations, gaps)
          this.setResult('计算 #' + run, (state === 437906867 ? 'PASS hash=' : 'FAIL hash=') + state + '; total=' + (end - started) + 'ms')
          this.setResult('计算 #' + run + ' 分片', 'sum=' + summary.computeMs + 'ms; max=' + summary.maxSliceMs + 'ms; firstWait=' + summary.firstWaitMs + 'ms')
          this.setResult('计算 #' + run + ' 后续等待', 'p50=' + summary.gapMedianMs + 'ms; p95=' + summary.gapP95Ms + 'ms; max=' + summary.gapMaxMs + 'ms (非RTF)')
          this.done('计算', 'DONE 65536 ops; 结果槽位 #' + run, token)
          return
        }
        this.timer = setTimeout(step, 10)
      } catch (error) { this.done('计算', 'FAIL ' + String(error), token) }
    }
    this.timer = setTimeout(step, 10)
  },
  checkLoad() { this.runData('whole') },
  checkScan() { this.runData('scan') },
  checkResident() { this.runData('resident') },
  checkAssemble() { this.runData('assemble') },
  runData(mode) {
    var label = 'D1 ' + mode
    var token = this.begin(label, 180000)
    if (token === null) return
    this.dataRun++
    this.setResult('D1 本轮', '#' + this.dataRun + ' ' + mode + '；冷/热运行请手记；heap 不可测')
    this.job = createDataProbe(file, DATA_ASSETS, mode, {
      row: (name, value) => { if (token === this.generation) this.setResult(name, value) },
      error: (message) => this.done(label, 'FAIL ' + message, token),
      done: (message) => this.done(label, message, token)
    })
    this.job.start()
  },
  playPackaged() { this.runAudio('packaged') },
  checkAppend() { this.runAudio('append') },
  checkPosition() { this.runAudio('position') },
  checkBuffered() { this.runAudio('buffered') },
  runAudio(mode) {
    var label = 'A1 ' + mode
    var token = this.begin(label, 60000)
    if (token === null) return
    this.fileSeq++
    var uri = 'internal://files/jspeak-probe-041-' + Date.now() + '-' + this.fileSeq + '.wav'
    this.setResult(label + ' 听感', 'UNVERIFIED 请记录是否听到清晰英文')
    this.setResult(label + ' 播放', 'WAITING 先校验字节')
    this.setResult(label + ' 清理', mode === 'packaged' ? 'N/A 包内资源' : 'WAITING ' + uri)
    this.job = createWavProbe(file, DATA_ASSETS.audio, mode, uri, {
      row: (name, value) => { if (token === this.generation) this.setResult(label + ' ' + name, value) },
      cleanup: (message) => this.setResult(label + ' 清理', message),
      error: (message) => this.done(label, 'FAIL ' + message, token),
      ready: (path) => {
        if (token !== this.generation) return
        try {
          audio.onplay = () => {
            if (token === this.generation) this.setResult(label + ' 播放', 'EVENT onplay 22050Hz；听感请手记')
          }
          audio.onended = () => {
            if (token !== this.generation) return
            this.setResult(label + ' 播放', 'EVENT onended；不自动判定听感')
            this.done(label, 'DONE bytes verified + ended event；听感待确认', token)
          }
          audio.onerror = (data) => this.done(label, 'FAIL audio ' + String(data), token)
          audio.src = path
          audio.play()
        } catch (error) { this.done(label, 'FAIL audio ' + String(error), token) }
      }
    })
    this.job.start()
  }
}
</script>
<style>
.page { flex-direction: column; background-color: #101010; padding: 28px 24px; }
.title { color: #ffffff; font-size: 25px; text-align: center; margin-bottom: 12px; }
.content { flex-grow: 1; flex-direction: column; }
.body { flex-direction: column; }
.note { color: #cccccc; font-size: 19px; margin-bottom: 12px; }
.button { height: 52px; margin-bottom: 10px; background-color: #303030; color: #ffffff; font-size: 21px; }
.result { flex-direction: column; margin-bottom: 18px; }
.label { color: #bbbbbb; font-size: 19px; }
.value { color: #ffffff; font-size: 20px; }
</style>
